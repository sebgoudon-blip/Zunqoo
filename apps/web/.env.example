# Copiez ce fichier en .env.local et remplissez avec la config de votre
# projet Firebase (Console Firebase > Paramètres du projet > Vos applications
# > Application Web).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Doit correspondre à la région choisie pour les Cloud Functions
# (voir firebase/functions/src/index.ts, REGION).
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
