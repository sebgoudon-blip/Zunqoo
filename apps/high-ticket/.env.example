# Mode cloud (comptes, synchronisation, assistant IA, connexion Shopify).
# Sans ces variables, l'app fonctionne en mode local dans le navigateur.
# Copiez ce fichier en .env.local et remplissez avec la config de votre
# projet Firebase (Console Firebase > Paramètres du projet > Vos applications
# > Application Web).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Doit correspondre à la région des Cloud Functions (europe-west1).
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# true pour utiliser les émulateurs locaux (auth, firestore, functions).
VITE_USE_EMULATORS=false
