# Copiez ce fichier en .env et remplissez avec la config de votre projet
# Firebase (Console Firebase > Paramètres du projet > Vos applications >
# Application Web — oui, même pour le mobile, on utilise le SDK JS Firebase).
#
# Ces variables sont lues via app.config avec des clés EXPO_PUBLIC_* pour
# être exposées au bundle JS d'Expo.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1

# Vendeur par défaut si le QR scanné n'encode pas explicitement un vendorId
# (utile en développement).
EXPO_PUBLIC_DEFAULT_VENDOR_ID=cocorico
