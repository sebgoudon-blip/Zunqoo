# Base de donnees
# En local : SQLite (aucune installation requise)
DATABASE_URL="file:./dev.db"
# En production : remplacer par une URL Postgres, ex :
# DATABASE_URL="postgresql://user:password@host:5432/avisfacile"

# Auth / sessions
# Genere une valeur aleatoire longue: `openssl rand -hex 32`
JWT_SECRET="change-moi-en-production"

# Mot de passe du module super-admin (prospection de leads)
SUPER_ADMIN_PASSWORD="change-moi-en-production"

# URL publique de l'application (utilisee dans les liens SMS/email)
APP_URL="http://localhost:3000"

# --- Stripe (paiement / abonnement) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs Stripe (Stripe Billing) pour l'offre standard et l'offre de lancement
STRIPE_PRICE_ID_STANDARD=""
STRIPE_PRICE_ID_LANCEMENT=""

# --- SMS (Twilio) ---
# Si vide, les SMS sont simules (loggés en console) au lieu d'etre envoyes reellement.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Email (Resend) ---
# Si vide, les emails sont simules (loggés en console).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Avis Facile <contact@avisfacile.fr>"

# --- Tache planifiee (envoi des demandes d'avis differees) ---
# Secret a fournir en en-tete "Authorization: Bearer <valeur>" pour declencher
# GET /api/cron/envoyer-demandes-avis depuis un service de cron externe (Vercel Cron, etc.)
CRON_SECRET="change-moi-en-production"

# --- Recherche de leads (Google Places API) ---
# Si vide, une recherche simulee (donnees mock) est utilisee a la place.
GOOGLE_PLACES_API_KEY=""
