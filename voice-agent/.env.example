# ============================================================================
# Zunqoo Voice — variables d'environnement
# Copier en .env et remplir. Ne jamais committer le .env.
# ============================================================================

# --- Déploiement -------------------------------------------------------------
# saas   : vous hébergez plusieurs commerçants (abonnement)
# onprem : installation chez un client (licence one-shot, LICENSE_FILE requis)
DEPLOYMENT_MODE=saas
TENANTS_DIR=data/tenants
CALLS_DIR=data/calls
# Tenant utilisé si l'appel ne peut pas être routé (pratique en mono-commerce)
DEFAULT_TENANT_ID=
# Jeton de l'API d'administration (onboarding, relevés) — générer avec: openssl rand -hex 32
ADMIN_API_TOKEN=

# --- LiveKit (Cloud ou auto-hébergé) -----------------------------------------
LIVEKIT_URL=wss://votre-projet.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=zunqoo-voice

# --- Speech-to-Text : Deepgram ----------------------------------------------
DEEPGRAM_API_KEY=
# nova-2 demandé dans le cahier des charges ; nova-3 est plus précis en français
DEEPGRAM_MODEL=nova-2

# --- LLM ----------------------------------------------------------------------
# anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Conversation (latence critique)
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
# Lecture du site à l'onboarding (une fois par commerce, précision maximale)
ANTHROPIC_EXTRACT_MODEL=claude-opus-5-5
# Compte-rendu après chaque appel (rapide, peu coûteux)
ANTHROPIC_REPORT_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EXTRACT_MODEL=gpt-4o
OPENAI_REPORT_MODEL=gpt-4o-mini

# --- Text-to-Speech -----------------------------------------------------------
# cartesia (par défaut, économique) | elevenlabs (surchargeable par tenant : voice.tts_provider)
TTS_PROVIDER=cartesia
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_DEFAULT_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
CARTESIA_DEFAULT_VOICE_ID=

# --- WhatsApp Business Cloud API (Meta) --------------------------------------
# Compte de la plateforme ; un tenant peut fournir le sien dans sa fiche.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
# Jeton permanent d'un "System User" (Business Manager), pas le jeton 24 h de test
WHATSAPP_ACCESS_TOKEN=
# Template UTILITY approuvé (voir README) ; laisser vide pour n'envoyer que du texte
WHATSAPP_TEMPLATE_NAME=zunqoo_call_report
WHATSAPP_TEMPLATE_LANG=fr

# --- Licences & facturation ---------------------------------------------------
# Générées avec: zunqoo-license keygen
LICENSE_PUBLIC_KEY=
# Uniquement sur la machine de l'éditeur, jamais chez le client :
LICENSE_PRIVATE_KEY=
# Mode onprem : chemin du fichier licence fourni au client
LICENSE_FILE=
STRIPE_SECRET_KEY=
USAGE_DB_PATH=data/usage.sqlite3

# --- Comportement --------------------------------------------------------------
MAX_CALL_DURATION_S=600
# model (détection sémantique de fin de phrase) | vad (silence seul)
TURN_DETECTOR=model
THINKING_SOUNDS=true
SCRAPER_MAX_PAGES=25
