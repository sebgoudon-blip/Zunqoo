# Copiez ce fichier en .env pour tester en local (ne le commitez jamais).
# Sur Vercel : Project → Settings → Environment Variables.

# Google Cloud → APIs & Services → activer « Places API (New) » → Identifiants → Clé API
GOOGLE_PLACES_API_KEY=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Code à taper dans l'outil pour avoir le droit de lancer des recherches
# (protège vos crédits Google et Claude). Choisissez ce que vous voulez.
POUSSE_ACCESS_CODE=
